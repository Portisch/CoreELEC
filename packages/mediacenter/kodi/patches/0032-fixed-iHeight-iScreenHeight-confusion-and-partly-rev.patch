From 3e1809466cc5127ba7d2ee3fe46980d54ce2838d Mon Sep 17 00:00:00 2001
From: tanio99 <tanio99@wolke7.net>
Date: Fri, 23 Aug 2019 09:14:37 +0200
Subject: [PATCH 32/41] fixed iHeight/iScreenHeight confusion and partly
 reverted changes in GraphicContext

---
 xbmc/utils/AMLUtils.cpp           | 8 ++++----
 xbmc/windowing/GraphicContext.cpp | 3 +--
 2 files changed, 5 insertions(+), 6 deletions(-)

diff --git a/xbmc/utils/AMLUtils.cpp b/xbmc/utils/AMLUtils.cpp
index 2483af1be2..769652e4a9 100644
--- a/xbmc/utils/AMLUtils.cpp
+++ b/xbmc/utils/AMLUtils.cpp
@@ -487,17 +487,17 @@ bool aml_mode_to_resolution(const char *mode, RESOLUTION_INFO *res)
 
     if (res->iScreenWidth == 1920)
     {
-      res->iScreenHeight = 2205;
+      res->iHeight = 2205;
       res->iBlanking = 45;
     }
 
     if (res->iScreenWidth == 1280)
     {
-      res->iScreenHeight = 1470;
+      res->iHeight = 1470;
       res->iBlanking = 30;
     }
 
-    res->strId = StringUtils::Format("%dfp%dhz", res->iHeight, rrate);
+    res->strId = StringUtils::Format("%dfp%dhz", res->iScreenHeight, rrate);
     res->dwFlags |= D3DPRESENTFLAG_MODE3DTB;
   }
 
@@ -806,7 +806,7 @@ void aml_disable_freeScale()
 
 void aml_set_framebuffer_resolution(const RESOLUTION_INFO &res, std::string framebuffer_name)
 {
-  aml_set_framebuffer_resolution(res.iScreenWidth, res.iScreenHeight, framebuffer_name);
+  aml_set_framebuffer_resolution(res.iWidth, res.iHeight, framebuffer_name);
 }
 
 void aml_set_framebuffer_resolution(int width, int height, std::string framebuffer_name)
diff --git a/xbmc/windowing/GraphicContext.cpp b/xbmc/windowing/GraphicContext.cpp
index b9dbebd60e..d0b6a3b960 100644
--- a/xbmc/windowing/GraphicContext.cpp
+++ b/xbmc/windowing/GraphicContext.cpp
@@ -439,7 +439,7 @@ void CGraphicContext::SetVideoResolutionInternal(RESOLUTION res, bool forceUpdat
   float origFPSOverride = m_fFPSOverride;
 
   UpdateInternalStateWithResolution(res);
-  RESOLUTION_INFO info_org  = GetResInfo(res);
+  RESOLUTION_INFO info_org  = CDisplaySettings::GetInstance().GetResolutionInfo(res);
 
   bool switched = false;
   if (CServiceBroker::GetSettingsComponent()->GetAdvancedSettings()->m_fullScreen)
@@ -629,7 +629,6 @@ const RESOLUTION_INFO CGraphicContext::GetResInfo(RESOLUTION res) const
     if((info.dwFlags & D3DPRESENTFLAG_MODE3DTB) == 0)
     {
       info.iBlanking      = info.iHeight == 1080 ? 45 : 30;
-      info.iScreenHeight  = info.iHeight * 2 + info.iBlanking;
       info.dwFlags       |= D3DPRESENTFLAG_MODE3DTB;
     }
   }
-- 
2.28.0

