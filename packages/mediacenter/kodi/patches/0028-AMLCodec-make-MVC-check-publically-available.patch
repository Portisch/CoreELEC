From d58bdd88c4c7388b9bc79b59f55010ab9d414881 Mon Sep 17 00:00:00 2001
From: tanio99 <tanio99@wolke7.net>
Date: Sat, 24 Aug 2019 10:47:39 +0200
Subject: [PATCH 28/41] AMLCodec: make MVC check publically available

---
 xbmc/cores/VideoPlayer/DVDCodecs/Video/AMLCodec.cpp | 7 ++++++-
 xbmc/cores/VideoPlayer/DVDCodecs/Video/AMLCodec.h   | 1 +
 2 files changed, 7 insertions(+), 1 deletion(-)

diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/AMLCodec.cpp b/xbmc/cores/VideoPlayer/DVDCodecs/Video/AMLCodec.cpp
index d02ccfb742..0c55c20540 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/AMLCodec.cpp
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/AMLCodec.cpp
@@ -1549,6 +1549,11 @@ int CAMLCodec::GetAmlDuration() const
   return am_private ? (am_private->video_rate * PTS_FREQ) / UNIT_FREQ : 0;
 };
 
+bool CAMLCodec::IsMvc(const CDVDStreamInfo &hints)
+{
+  return hints.codec_tag == CODEC_TAG_AMVC || hints.codec_tag == CODEC_TAG_MVC1;
+}
+
 bool CAMLCodec::OpenDecoder(CDVDStreamInfo &hints)
 {
   m_speed = DVD_PLAYSPEED_NORMAL;
@@ -1641,7 +1646,7 @@ bool CAMLCodec::OpenDecoder(CDVDStreamInfo &hints)
   am_private->video_format      = codecid_to_vformat(hints.codec);
 
   // in case we're watching MVC content, switch the video_format
-  if (hints.codec_tag == CODEC_TAG_AMVC || hints.codec_tag == CODEC_TAG_MVC1)
+  if (IsMvc(hints))
     am_private->video_format = VFORMAT_H264MVC;
 
   if ((am_private->video_format == VFORMAT_H264)
diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/AMLCodec.h b/xbmc/cores/VideoPlayer/DVDCodecs/Video/AMLCodec.h
index 7ce3ff116b..5238f738d4 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/AMLCodec.h
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/AMLCodec.h
@@ -53,6 +53,7 @@ public:
 
   static int    PollFrame();
   static void   SetPollDevice(int device);
+  static bool   IsMvc(const CDVDStreamInfo &hints);
 
 private:
   void          ShowMainVideo(const bool show);
-- 
