+
+int is_need_mvc_to_sbs_output(void)
+{
+	return cur_dispbuf && (cur_dispbuf->type & VIDTYPE_MVC)
+		&& (process_3d_type & MODE_3D_MVC_TO_SBS) == MODE_3D_MVC_TO_SBS;
